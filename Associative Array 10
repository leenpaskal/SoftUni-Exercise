function garage(input){

    let garages = {};

    for(let line of input){

        let[garageNo, carInfo] = line.split(' - ');
     
        if(!garages[garageNo]){
            garages[garageNo] = [];
        }

        let formatedCar = carInfo
        .split(", ")
        .map(info => info.replace(`:`, ` -`))
        .join(', ');

        garages[garageNo].push(formatedCar);

    }

    for(let[num,cars] of Object.entries(garages)){
        console.log(`Garage № ${num}`);
        cars.forEach(car => console.log(`--- ${car}`));
    }

}
