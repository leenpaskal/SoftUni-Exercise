function comments (input){

let articles = {};
let usersToCheck = {};

    for(let line of input){

        let users = {
            "name":"",
            "title":"",
            "content":""
        };

        if(line.includes("user")){

            let user = line.replace("user ", "");
            usersToCheck[user] = {};

        } else if(line.includes("posts")){

            let [parameters, contents] = line.split(": ");
            let [user, article] = parameters.replace(" posts on", "").split(" ");
            let [title, content] = contents.split(", ");

            if (usersToCheck.hasOwnProperty(user) && articles.hasOwnProperty(article)){

                users["name"] = user;
                users["title"] = title;
                users["content"] = content;

                if(articles[article].length >= 1){
                    articles[article].push(users);
                } else {
                articles[article] = [users];
                }

            }

        } else if(line.includes("article")){

            let article = line.replace("article ", "");
            articles[article] = {};

        }

    }

    let sortedArr = Object.entries(articles).sort((a,b) => b[1].length - a[1].length);
    

    for(let [article, content] of sortedArr){

        console.log(`Comments on ${article}`)

        let sortedNames = content.sort((a,b) => a["name"].localeCompare(b["name"]));

        for(let comment of sortedNames){

            console.log(`--- From user ${comment["name"]}: ${comment["title"]} - ${comment["content"]}`);

        }

    }

}

comments([
