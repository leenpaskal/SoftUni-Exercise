function solve(input){

let pattern = /\b(?<day>\d{2})([-\.\/])(?<month>[A-Z][a-z]{2})\2(?<year>[0-9]{4})\b/g;

let words = input[0].matchAll(pattern);


for(let item of words){
    
    let day = item.groups['day'];
    let month = item.groups['month'];
    let year = item.groups['year'];

    console.log(`Day: ${day}, Month: ${month}, Year: ${year}`)
}
}

solve(['13/Jul/1928, 10-Nov-1934, , 01/Jan-1951,f 25.Dec.1937 23/09/1973, 1/Feb/2016']);
