function solve(arr){

    let string = arr[0];
    let pattern = /([@#])([A-Za-z]{3,})\1\1([A-Za-z]{3,})\1/g;
    let arrNew = [];
    let matches = [...string.matchAll(pattern)]

    for(let line of matches){

        let wordOne = line[2];
        let wordTwo = line[3];

        let reversedTwo = wordTwo.split("").reverse().join("");

        if(wordOne === reversedTwo){

            let toAdd = `${wordOne} <=> ${wordTwo}`;
            arrNew.push(toAdd);

        }

    }

    if(matches.length > 0){

        console.log(`${matches.length} word pairs found!`);

    } else {

        console.log(`No word pairs found!`);

    };

    if(arrNew.length > 0){

        console.log(`The mirror words are:`);

        let stringToPrint = arrNew.join(", ");

        console.log(stringToPrint);

    } else {

        console.log(`No mirror words!`);

    } 

}

