function solve(arr) {
    let string = arr[0];

    const pattern = /([#|])([A-Za-z ]+)\1(\d{2}\/\d{2}\/\d{2})\1(\d+)\1/g;

    let caloriesTotal = 0;
    let items = [];
    let match;

    while ((match = pattern.exec(string)) !== null) {
        const name = match[2];
        const date = match[3];
        const calories = Number(match[4]);

        caloriesTotal += calories;
        items.push({ name, date, calories });
    }

    const daysOfFood = Math.floor(caloriesTotal / 2000);
    console.log(`You have food to last you for: ${daysOfFood} days!`);

    for (const item of items) {
        console.log(`Item: ${item.name}, Best before: ${item.date}, Nutrition: ${item.calories}`);
    }
}


solve([

'#Bread#19/03/21#4000#|Invalid|03/03.20||Apples|08/10/20|200||Carrots|06/08/20|500||Not right|6.8.20|5|'

]);
