function solve(input){

    let pattern = /([=\/])[A-Z][A-Za-z]{2,}\1/g;

    let matches = input.match(pattern);
    
    let sum = 0;

    let countries = [];

    if(matches){

        for(let item of matches){
            
            let word = item.slice(1,-1);
            sum += word.length;
            countries.push(word);
            
        }

    }

    console.log(`Destinations: ${countries.join(", ")}`);
    console.log(`Travel Points: ${sum}`);

}
