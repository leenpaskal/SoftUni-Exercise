function solve (arr){

    let objectTable = {};

    for(let item of arr){
        let [town, product, price] = item.split(" | ");
        price = Number(price);

        if(!objectTable.hasOwnProperty(product)){
            objectTable[product] = {town, price}
        } 
        
        if (objectTable.hasOwnProperty(product)) {
            if(objectTable[product].price > price){
                objectTable[product].price = price;
                objectTable[product].town = town;
            }
        }   
    }

    for(let line in objectTable){
        console.log(`${line} -> ${objectTable[line].price} (${objectTable[line].town})`);
    }

}
