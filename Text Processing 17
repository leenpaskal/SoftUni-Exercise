function solve(arr) {
    
    let password = arr.shift();

    let command = arr.shift();

    while (command !== "Done") {
        let parts = command.split(" ");
        let action = parts[0];

        if (action === "TakeOdd") {
            // Take characters at odd indices
            let newPassword = "";
            for (let i = 1; i < password.length; i += 2) {
                newPassword += password[i];
            }
            password = newPassword;
            console.log(password);

        } else if (action === "Cut") {
            
            let index = Number(parts[1]);
            let length = Number(parts[2]);
            password = password.slice(0, index) + password.slice(index + length);
            console.log(password);

        } else if (action === "Substitute") {
            
            let substring = parts[1];
            let substitute = parts[2];

            if (password.includes(substring)) {
                password = password.split(substring).join(substitute);
                console.log(password);
            } else {
                console.log("Nothing to replace!");
            }
        }

        
        command = arr.shift();
    }

    
    console.log(`Your password is: ${password}`);
    
}

solve(["Siiceercaroetavm!:?:ahsott.:i:nstupmomceqr", 
"TakeOdd",
"Cut 15 3",
"Substitute :: -",
"Substitute | ^",
"Done"]);
